# Server Configuration
PORT=5000

# Database Connection (MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bookmyshow?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_token_key_here

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Nodemailer SMTP Credentials (Gmail App Password)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

